      "item": [
        {
          "name": "Check Device Registration",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{Base_url}}/api/v1/app/device/check?device_fingerprint=UNIQUE_FINGERPRINT_123",
              "host": ["{{Base_url}}"],
              "path": ["api", "v1", "app", "device", "check"],
              "query": [ { "key": "device_fingerprint", "value": "UNIQUE_FINGERPRINT_123" } ]
            }
          }
        },
        {
          "name": "Upload Background Screenshot",
          "request": {
            "method": "POST",
            "header": [ { "key": "X-Device-Fingerprint", "value": "UNIQUE_FINGERPRINT_123" } ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "screenshot", "type": "file", "src": "/path/to/screenshot.jpg" },
                { "key": "captured_at", "type": "text", "value": "2026-09-12T12:00:00Z" },
                { "key": "notes", "type": "text", "value": "Background screenshot" }
              ]
            },
            "url": { "raw": "{{Base_url}}/api/v1/app/employee-screenshots", "host": ["{{Base_url}}"], "path": ["api", "v1", "app", "employee-screenshots"] }
          }
        },
        {
          "name": "Save Employee Activity",
          "request": {
            "method": "POST",
            "header": [ { "key": "X-Device-Fingerprint", "value": "UNIQUE_FINGERPRINT_123" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"keyboard_activity\": 125,\n  \"mouse_activity\": 84,\n  \"keystrokes\": [\"H\", \"e\", \"l\", \"l\", \"o\"],\n  \"mouse_events\": [\n    {\"type\": \"move\", \"x\": 640, \"y\": 360},\n    {\"type\": \"click\", \"button\": \"left\", \"x\": 640, \"y\": 360}\n  ],\n  \"captured_at\": \"2026-09-13T12:00:00Z\"\n}" },
            "url": { "raw": "{{Base_url}}/api/v1/app/employee-activity", "host": ["{{Base_url}}"], "path": ["api", "v1", "app", "employee-activity"] }
          }
        },
        {
          "name": "Save Application Usage",
          "request": {
            "method": "POST",
            "header": [ { "key": "X-Device-Fingerprint", "value": "UNIQUE_FINGERPRINT_123" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"application_name\": \"Visual Studio Code\",\n  \"executable_name\": \"Code.exe\",\n  \"window_title\": \"index.js - project - Visual Studio Code\",\n  \"started_at\": \"2026-09-14T10:00:00Z\",\n  \"ended_at\": \"2026-09-14T10:05:00Z\",\n  \"duration_seconds\": 300\n}" },
            "url": { "raw": "{{Base_url}}/api/v1/app/applications", "host": ["{{Base_url}}"], "path": ["api", "v1", "app", "applications"] }
          }
        },
        {
          "name": "Save Website Usage",
          "request": {
            "method": "POST",
            "header": [ { "key": "X-Device-Fingerprint", "value": "UNIQUE_FINGERPRINT_123" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"domain\": \"github.com\",\n  \"url\": \"https://github.com/my/project\",\n  \"page_title\": \"Project Overview\",\n  \"started_at\": \"2026-09-14T10:05:00Z\",\n  \"ended_at\": \"2026-09-14T10:10:00Z\",\n  \"duration_seconds\": 300\n}" },
            "url": { "raw": "{{Base_url}}/api/v1/app/websites", "host": ["{{Base_url}}"], "path": ["api", "v1", "app", "websites"] }
